# Shared key for Docker and scripts/start-backend.ps1; file overrides stale shell keys.
# Copy to .env.compose and set a local secret before starting Compose.
FORTEBANK_API_KEY=
BACKEND_URL=http://host.docker.internal:8000

# Windows host ML + Docker frontend: compose.host-ml.yaml.
# Use the same key as the host backend. Default Compose does not enable mocks.
# Synthetic transport/UI only: explicitly add compose.mock.yaml.

# Brev GPU deployment: compose.yaml + compose.real.yaml (both files required).
# MODEL_RUNS_PATH=./runs
# ACTION_SERVICE_CONFIG=./configs/action_service_backend_smoke.yaml
