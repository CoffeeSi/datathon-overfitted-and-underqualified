# Server-only settings. Copy this file to frontend/.env.local.
# Never use NEXT_PUBLIC_ for the shared API key.
BACKEND_URL=http://127.0.0.1:8000
FORTEBANK_API_KEY=

# Must match FORTEBANK_MAX_UPLOAD_MB on the Python backend.
MAX_UPLOAD_MB=100

# Explicit synthetic UI examples only. Never a fallback for failed real analysis.
DEMO_ENABLED=false
