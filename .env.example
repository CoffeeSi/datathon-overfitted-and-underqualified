# Copy to .env in the repository root; used by notebooks/02_detection.ipynb.
RUN_TRAINING=false
# Optional binary ablations: r3d18_negatives.yaml, r3d18_geometry.yaml, r3d18_roi.yaml.
# TRAIN_CONFIG=configs/r3d18_roi.yaml
# IMPROVEMENT_STUDY=runs/binary_improvements_<UTC>
TRAIN_EPOCHS=5
TRAIN_DEVICE=cuda
EXISTING_RUN=runs/r3d18_smoke
EVAL_DEVICE=cuda
# Set this when multiple runs are present; a single available best.pt is auto-selected.
# CHECKPOINT_PATH=runs/my_experiment/best.pt

# Optional; by default each training run gets a fresh timestamped output directory.
# TRAIN_OUTPUT_DIR=runs/my_experiment
# TRAIN_CONFIG=configs/r3d18_augmented.yaml
# Matched original/augmentation study is separately opt-in (120 fixed updates).
RUN_MATCHED_TRAINING=false
# MATCHED_STUDY_REPORT=reports/matched_augmentation_study_<UTC>.json
# VIDEO_DIR=data/raw/videos
# Full-video research (does not enable training).
RUN_FULL_SCAN=false
# SCAN_VIDEO=data/raw/videos/X-1.mov
# annotation_windows | full_video | both | actions | primitives | banknotes
EVAL_PROTOCOL=annotation_windows
# Use configs/full_video_context8.yaml with a checkpoint trained on 8-second windows.
# FULL_VIDEO_CONFIG=configs/full_video.yaml

# Action experiments are opt-in; current weights have poor measured quality.
RUN_ACTION_TRAINING=false
RUN_ACTION_EVAL=false
ACTION_DEVICE=cpu
ACTION_CONFIG=configs/actions_balanced.yaml
# Historical experiment inputs, if current annotation metadata has since changed:
# ACTION_EVAL_CONFIG=runs/r3d18_actions_balanced_20261018T004011Z/evaluation_config.json
# ACTION_CHECKPOINT_PATH=runs/r3d18_actions_balanced_20261018T004011Z/last.pt
# ACTION_ENABLED_TYPES=client_identity_check_not_visible
# EVAL_PROTOCOL=actions skips binary evaluations when inspecting action results.
# Real backend (requires BOTH checkpoints and explicitly enabled evaluated types):
# FORTEBANK_ANALYZER_FACTORY=overfitted_underqualified.backend.local_analyzer:create_analyzer
# FORTEBANK_ACTION_CONFIG=configs/action_service.yaml
# For research only, explicitly use configs/action_service_research.yaml.

# Visible primitives and causal service history; independent opt-in research workflow.
PRIMITIVE_CONFIG=configs/primitives_multiview.yaml
PRIMITIVE_DEVICE=cuda
RUN_PRIMITIVE_TRAINING=false
RUN_PRIMITIVE_EVAL=false
SHOW_PRIMITIVE_SAMPLES=false
SHOW_PRIMITIVE_ERROR_FRAMES=false
# PRIMITIVE_CHECKPOINT_PATH=runs/primitives_RUN/last.pt
# PRIMITIVE_REPORT_DIR=reports/evaluation_primitives_RUN
# EVAL_PROTOCOL=primitives skips binary evaluations in 03.

# Counter-banknote detector + primitive sequence. External source manifest is local.
BANKNOTE_CONFIG=configs/banknotes.yaml
BANKNOTE_DEVICE=cuda
BANKNOTE_TRACKING=false
RUN_BANKNOTE_TRAINING=false
RUN_BANKNOTE_EVAL=false
SHOW_BANKNOTE_SAMPLES=false
SHOW_BANKNOTE_ERRORS=false
# BANKNOTE_CHECKPOINT_PATH=runs/banknotes_RUN/last.pt
# BANKNOTE_REPORT_DIR=reports/evaluation_banknotes_RUN
# EVAL_PROTOCOL=banknotes skips binary evaluation in 03.
