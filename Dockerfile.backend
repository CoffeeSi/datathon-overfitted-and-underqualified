FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements-backend.txt requirements-service-ml.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

# The default image stays small for the explicit mock setup. The real-model
# Compose override enables the project's pinned Torch/CUDA stack.
ARG INSTALL_ML=false
RUN if [ "$INSTALL_ML" = "true" ]; then \
      pip install --no-cache-dir -r requirements-service-ml.txt \
      && pip install --no-cache-dir -r requirements-ml.txt; \
    fi

COPY src/ ./src/
COPY configs/ ./configs/

RUN useradd --system --create-home appuser \
    && mkdir -p /app/data/service \
    && chown -R appuser:appuser /app/data
USER appuser

EXPOSE 8000
CMD ["uvicorn", "overfitted_underqualified.backend.api:app", "--host", "0.0.0.0", "--port", "8000"]
